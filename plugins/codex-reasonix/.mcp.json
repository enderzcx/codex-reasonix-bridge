{
  "mcpServers": {
    "codex-reasonix": {
      "command": "node",
      "args": ["./scripts/mcp_server.mjs"],
      "cwd": ".",
      "env_vars": [
        "OLLAMA_API_KEY",
        "REASONIX_BIN",
        "CRB_BIN",
        "CODEX_REASONIX_TIMEOUT_MS",
        "CRB_TIMEOUT_MS",
